# DofuPDF environment variables (all optional — sensible defaults are baked into the code).
# Copy this file to .env.local for local overrides.

# Canonical site URL used for metadata, canonical links and sitemap.
# Default: https://dofupdf.com
NEXT_PUBLIC_SITE_URL=https://dofupdf.com

# GitHub organization / repository URL shown in the footer and About page.
# Default: https://github.com/Jimsnote/dofupdf
NEXT_PUBLIC_GITHUB_URL=https://github.com/Jimsnote/dofupdf

# Cloudflare Web Analytics token. When set, the (cookieless) beacon script is
# injected into the root layout. Leave empty to disable analytics.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Google AdSense client id (e.g. ca-pub-xxxxxxxxxxxxxxxx). When set, the
# AdBanner component can render ad units. Leave empty to disable ads.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ---------------------------------------------------------------------------
# Worker-side variables (src/worker/index.js). These are NOT build-time
# NEXT_PUBLIC_* vars: set them in the Cloudflare dashboard for production,
# or in .dev.vars when running `npx wrangler dev` locally.
# ---------------------------------------------------------------------------

# Payhip product secret for Pro license verification. Required in production;
# without it the license API answers 503 license_unavailable.
PAYHIP_PRODUCT_SECRET=

# Explicit opt-in for the local-only DEMO mode (fail-closed since batch B).
# Set ALLOW_DEMO=true in .dev.vars to run DEMO E2E against `npx wrangler dev`.
# NEVER configure it in production (it has no effect once the secret is set,
# but keep it absent anyway).
ALLOW_DEMO=
